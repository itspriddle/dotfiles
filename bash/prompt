#!/usr/bin/env bash

# "%": untracked files in repo
# export GIT_PS1_SHOWUNTRACKEDFILES=1

# "+": staged (swapped for green '•')
# "*": unstaged (swapped for magenta '•')
export GIT_PS1_SHOWDIRTYSTATE=1
export GIT_PS1_DIRTYSTATE_UNSTAGED_MARK='_UNSTAGED_'
export GIT_PS1_DIRTYSTATE_STAGED_MARK='_STAGED_'

# "$": something stashed
# export GIT_PS1_SHOWSTASHSTATE=1

# shellcheck disable=1091
source "$HOME/.dotfiles/bash/shrink-path"

_josh_prompt_command() {
  local blue cyan yellow reset magenta green git dimmed job_count job host cwd prompt_cwd

  blue='\[\e[1;34m\]'
  cyan='\[\e[0;36m\]'
  yellow='\[\e[1;33m\]'
  reset='\[\e[0m\]'
  magenta='\[\e[1;35m\]'
  green='\[\e[1;32m\]'
  dimmed='\[\e[2;34m\]'

  git="$(__git_ps1 " ${cyan}(%s)${reset}" 2> /dev/null)"
  git="${git/$GIT_PS1_DIRTYSTATE_UNSTAGED_MARK/${magenta}•${cyan}}"
  git="${git/$GIT_PS1_DIRTYSTATE_STAGED_MARK/${green}•${cyan}}"

  if [ "$SSH_CONNECTION" ]; then
    if [ "$USER" = priddle ]; then
      host="${yellow}\\H${reset}:"
    else
      host="${yellow}\\u@\\H${reset}:"
    fi
  fi

  cwd="${PWD/#$HOME/$'~'}"

  # ${var@P} (bash 4.4+) expands the \j prompt escape without a subshell
  if (( BASH_VERSINFO[0] > 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4) )); then
    local j='\j'
    job_count="${j@P}"
  else
    job_count=$(( $(jobs -p | wc -l) ))
  fi

  if (( job_count > 0 )); then
    job="${dimmed}[${job_count}]${reset} "
  fi

  shrink-path -l 2 -s -t -v prompt_cwd
  prompt_cwd="${blue}${prompt_cwd}${reset}"

  PS1="${job}${host}${prompt_cwd}${git} \$ "

  case "$TERM" in
    xterm*|rxvt*)
      if [ "$SSH_CONNECTION" ] && [ "$USER" != priddle ]; then
        printf '\e]0;%s@%s:%s\a' "$USER" "$HOSTNAME" "$cwd"
      elif [ "$SSH_CONNECTION" ]; then
        printf '\e]0;%s:%s\a' "$HOSTNAME" "$cwd"
      else
        printf '\e]0;%s\a' "$cwd"
      fi
      ;;
  esac
}

export PROMPT_COMMAND="_josh_prompt_command${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
