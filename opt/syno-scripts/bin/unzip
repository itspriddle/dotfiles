#!/usr/bin/env bash
# Usage: unzip [-cflptuvz[jnoqC]] [-P password] file[.zip] [file(s) ...] [-x xfile(s) ...] [-d exdir]
#
# Info-ZIP unzip work-alike backed by 7z. Wildcards in file(s)/xfile(s) follow
# unzip rules (`*` also matches `/`). A wildcard zipfile processes every match.
#
#   -p  extract files to pipe, no messages     -l  list files (short format)
#   -f  freshen existing files, create none    -t  test compressed archive data
#   -u  update files, create if necessary      -z  display archive comment only
#   -v  list verbosely                         -x  exclude files that follow
#   -c  extract files to stdout with names     -d  extract files into exdir
#
# Modifiers:
#   -n  never overwrite existing files         -q  quiet mode (-qq => quieter)
#   -o  overwrite files WITHOUT prompting      -j  junk paths (do not make dirs)
#   -C  match filenames case-insensitively     -P  password for encrypted entries
#
# Set SEVENZIP to pick the 7z binary (default: first of 7z, 7za, 7zz found).

set -uo pipefail

if [[ -n "${DEBUG:-}" ]]; then
  export PS4='+ [${BASH_SOURCE##*/}:${LINENO}] '
  set -x
fi

PROG="unzip"

# unzip exit codes
readonly E_OK=0 E_WARN=1 E_ERR=2 E_NOZIP=9 E_PARAM=10 E_FIND=11 E_BADPWD=82

usage() {
  sed -ne '/^#/!q;s/^#$/# /;/^# /s/^# //p' < "$0"
}

err() {
  printf '%s:  %s\n' "$PROG" "$*" >&2
}

# ---------------------------------------------------------------------------
# Option parsing
# ---------------------------------------------------------------------------

MODE="extract"     # extract | list | verbose | test | pipe | cat | comment
OVERWRITE="prompt" # prompt | always | never
FRESHEN=0
UPDATE=0
JUNK=0
QUIET=0
NOCASE=0
PASSWORD=""
HAVE_PASSWORD=0
EXDIR=""
ARCHIVE_ARG=""
INCLUDES=()
EXCLUDES=()

warn_unsupported() {
  printf '%s:  warning: option -%s not supported by 7z wrapper, ignored\n' "$PROG" "$1" >&2
}

# Parse a bundle of single-letter options (without the leading dash).
# Sets SHIFT_NEXT=1 when the following argv element was consumed as a value.
parse_bundle() {
  local bundle="$1" next="${2-}" has_next="$3" i c rest
  SHIFT_NEXT=0

  for ((i = 0; i < ${#bundle}; i++)); do
    c="${bundle:i:1}"
    rest="${bundle:i+1}"

    case "$c" in
      c) MODE="cat" ;;
      f) FRESHEN=1 ;;
      l) MODE="list" ;;
      p) MODE="pipe" ;;
      t) MODE="test" ;;
      u) UPDATE=1 ;;
      v) MODE="verbose" ;;
      z) MODE="comment" ;;
      n) OVERWRITE="never" ;;
      o) OVERWRITE="always" ;;
      j) JUNK=1 ;;
      q) QUIET=$((QUIET + 1)) ;;
      C) NOCASE=1 ;;
      h) usage; exit "$E_OK" ;;
      d | P)
        local val
        if [[ -n "$rest" ]]; then
          val="$rest"
        elif [[ "$has_next" == 1 ]]; then
          val="$next"
          SHIFT_NEXT=1
        else
          err "option -$c requires an argument"
          exit "$E_PARAM"
        fi
        if [[ "$c" == d ]]; then
          EXDIR="$val"
        else
          PASSWORD="$val"
          HAVE_PASSWORD=1
        fi
        return
        ;;
      a | b | s | B | D | K | L | M | T | U | V | W | X | '$' | ':' | '^')
        warn_unsupported "$c"
        ;;
      Z)
        err "zipinfo mode (-Z) is not supported"
        exit "$E_PARAM"
        ;;
      *)
        err "unknown option -$c"
        usage >&2
        exit "$E_PARAM"
        ;;
    esac
  done
}

parse_args() {
  local state="opts" arg has_next

  while (($# > 0)); do
    arg="$1"
    has_next=0
    (($# > 1)) && has_next=1

    if [[ "$arg" == "--help" ]]; then
      usage
      exit "$E_OK"
    fi

    case "$state" in
      opts)
        if [[ "$arg" == -?* ]]; then
          parse_bundle "${arg#-}" "${2-}" "$has_next"
          shift $((1 + SHIFT_NEXT))
          continue
        fi
        ARCHIVE_ARG="$arg"
        state="files"
        ;;
      files | xfiles)
        if [[ "$arg" == -d* ]]; then
          if [[ "$arg" != "-d" ]]; then
            EXDIR="${arg#-d}"
          elif [[ "$has_next" == 1 ]]; then
            EXDIR="$2"
            shift
          else
            err "option -d requires an argument"
            exit "$E_PARAM"
          fi
        elif [[ "$arg" == "-x" ]]; then
          state="xfiles"
        elif [[ "$state" == "files" ]]; then
          INCLUDES+=("$arg")
        else
          EXCLUDES+=("$arg")
        fi
        ;;
    esac
    shift
  done
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

find_7z() {
  local cand

  if [[ -n "${SEVENZIP:-}" ]]; then
    command -v "$SEVENZIP" >/dev/null 2>&1 && { SZ="$SEVENZIP"; return 0; }
    err "SEVENZIP=$SEVENZIP not found"
    return 1
  fi

  for cand in 7z 7za 7zz; do
    if command -v "$cand" >/dev/null 2>&1; then
      SZ="$cand"
      return 0
    fi
  done

  err "7z not found in PATH (tried 7z, 7za, 7zz)"
  return 1
}

# Convert "YYYY-MM-DD HH:MM:SS" (local time) to epoch seconds.
to_epoch() {
  date -d "$1" +%s 2>/dev/null || date -j -f '%Y-%m-%d %H:%M:%S' "$1" +%s 2>/dev/null
}

file_mtime() {
  stat -c %Y -- "$1" 2>/dev/null || stat -f %m -- "$1" 2>/dev/null
}

# Map a 7z exit status to the closest unzip exit status.
map_rc() {
  case "$1" in
    0) echo "$E_OK" ;;
    1) echo "$E_WARN" ;;
    7) echo "$E_PARAM" ;;
    8) echo 5 ;;
    255) echo 80 ;;
    *) echo "$E_ERR" ;;
  esac
}

# Run 7z, feeding the password on stdin (keeps it out of the process list).
run_7z() {
  if [[ "$HAVE_PASSWORD" == 1 ]]; then
    printf '%s\n' "$PASSWORD" | "$SZ" "$@"
  else
    "$SZ" "$@" </dev/null
  fi
}

# Read an entry's display name: directories get a trailing slash.
dname() {
  local i="$1"
  if [[ "${E_DIR[i]}" == 1 ]]; then
    printf '%s/' "${E_PATH[i]}"
  else
    printf '%s' "${E_PATH[i]}"
  fi
}

# ---------------------------------------------------------------------------
# Archive listing
# ---------------------------------------------------------------------------

E_PATH=() E_DIR=() E_SIZE=() E_PACKED=() E_MTIME=() E_CRC=() E_METHOD=() E_ENC=()
ARCHIVE_COMMENT=""

load_entries() {
  local archive="$1" out rc line key val section="head" in_comment=0 n=-1

  E_PATH=() E_DIR=() E_SIZE=() E_PACKED=() E_MTIME=() E_CRC=() E_METHOD=() E_ENC=()
  ARCHIVE_COMMENT=""

  out=$("$SZ" l -slt -sccUTF-8 -bsp0 -- "$archive" </dev/null 2>"$TMP/list.err")
  rc=$?
  if ((rc != 0)); then
    cat "$TMP/list.err" >&2
    err "cannot read $archive with 7z"
    return "$(map_rc "$rc")"
  fi

  while IFS= read -r line; do
    if [[ "$section" == "head" ]]; then
      if [[ "$line" == "----------" ]]; then
        section="entries"
        in_comment=0
      elif ((in_comment)); then
        if [[ -z "$line" ]]; then
          in_comment=0
        else
          ARCHIVE_COMMENT+=$'\n'"$line"
        fi
      elif [[ "$line" == "Comment = "* ]]; then
        ARCHIVE_COMMENT="${line#Comment = }"
        in_comment=1
      fi
      continue
    fi

    [[ "$line" == *" = "* ]] || continue
    key="${line%% = *}"
    val="${line#* = }"

    case "$key" in
      Path)
        n=$((n + 1))
        E_PATH[n]="$val"
        E_DIR[n]=0 E_SIZE[n]=0 E_PACKED[n]=0 E_MTIME[n]="" E_CRC[n]="" E_METHOD[n]="" E_ENC[n]=0
        ;;
      Folder) [[ "$val" == "+" ]] && E_DIR[n]=1 ;;
      Attributes) [[ "$val" == D* ]] && E_DIR[n]=1 ;;
      Size) E_SIZE[n]="${val:-0}" ;;
      "Packed Size") E_PACKED[n]="${val:-0}" ;;
      Modified) E_MTIME[n]="$val" ;;
      CRC) E_CRC[n]="$val" ;;
      Method) E_METHOD[n]="$val" ;;
      Encrypted) [[ "$val" == "+" ]] && E_ENC[n]=1 ;;
    esac
  done <<<"$out"

  # Strip trailing newline 7z may leave in a multi-line comment
  ARCHIVE_COMMENT="${ARCHIVE_COMMENT%$'\n'}"
  return 0
}

# ---------------------------------------------------------------------------
# Selection (include/exclude patterns, unzip wildcard semantics)
# ---------------------------------------------------------------------------

SEL=()
UNMATCHED=()

select_entries() {
  local i name pat matched rc="$E_OK"
  local -a inc_hit=()

  SEL=()
  UNMATCHED=()
  ((NOCASE)) && shopt -s nocasematch

  for ((i = 0; i < ${#E_PATH[@]}; i++)); do
    name="$(dname "$i")"

    if ((${#INCLUDES[@]} > 0)); then
      matched=0
      for pat in "${!INCLUDES[@]}"; do
        # shellcheck disable=SC2053 # intentional glob match
        if [[ "$name" == ${INCLUDES[pat]} || "${E_PATH[i]}" == ${INCLUDES[pat]} ]]; then
          matched=1
          inc_hit[pat]=1
        fi
      done
      ((matched)) || continue
    fi

    matched=0
    for pat in "${EXCLUDES[@]}"; do
      # shellcheck disable=SC2053
      if [[ "$name" == $pat || "${E_PATH[i]}" == $pat ]]; then
        matched=1
        break
      fi
    done
    ((matched)) && continue

    SEL+=("$i")
  done

  shopt -u nocasematch

  for pat in "${!INCLUDES[@]}"; do
    if [[ -z "${inc_hit[pat]:-}" ]]; then
      UNMATCHED+=("${INCLUDES[pat]}")
      rc="$E_FIND"
    fi
  done

  return "$rc"
}

# Get and verify a password when selected entries are encrypted. Encrypted
# entries the password can't open are dropped from SEL with unzip's
# "skipping" message, and BADPWD is set so the archive exits 82.
BADPWD=0
BADPWD_KEPT=0

ensure_password() {
  local archive="$1" i small="" why="incorrect password"
  local -a keep=()

  for i in "${SEL[@]}"; do
    [[ "${E_ENC[i]}" == 1 && "${E_DIR[i]}" != 1 ]] || continue
    if [[ -z "$small" ]] || ((E_PACKED[i] < E_PACKED[small])); then
      small="$i"
    fi
  done
  [[ -z "$small" ]] && return 0

  if ((!HAVE_PASSWORD)); then
    if { : >/dev/tty; } 2>/dev/null; then
      printf '[%s] %s password: ' "$archive" "${E_PATH[small]}" >/dev/tty
      IFS= read -rs PASSWORD </dev/tty || why="unable to get password"
      printf '\n' >/dev/tty
    else
      IFS= read -rs PASSWORD || why="unable to get password"
    fi
    HAVE_PASSWORD=1
  fi

  # Test the smallest encrypted entry: a wrong password makes 7z leave
  # empty/partial files behind, which unzip never does.
  printf '%s\n' "${E_PATH[small]}" >"$TMP/pw.lst"
  run_7z t -bso0 -bsp0 -bse2 -sccUTF-8 -scsUTF-8 "-ir-@$TMP/pw.lst" -- "$archive" \
    2>"$TMP/pw.err"
  grep -q 'Wrong password' "$TMP/pw.err" || return 0

  for i in "${SEL[@]}"; do
    if [[ "${E_ENC[i]}" == 1 && "${E_DIR[i]}" != 1 ]]; then
      BADPWD=$((BADPWD + 1))
      [[ "$MODE" == "pipe" ]] || printf '   skipping: %-22s  %s\n' "${E_PATH[i]}" "$why"
    else
      keep+=("$i")
    fi
  done
  SEL=("${keep[@]}")
  BADPWD_KEPT=${#SEL[@]}
}

# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------

print_header() {
  ((QUIET)) && return 0
  printf 'Archive:  %s\n' "$1"
  [[ -n "$ARCHIVE_COMMENT" ]] && printf '%s\n' "$ARCHIVE_COMMENT"
  return 0
}

# unzip's per-file action line, e.g. "  inflating: dir/file.txt"
print_action() {
  local method="$1" path="$2"
  case "$method" in
    *Store* | Copy) printf ' extracting: %-22s  \n' "$path" ;;
    *) printf '  inflating: %-22s  \n' "$path" ;;
  esac
}

fmt_date() { # "YYYY-MM-DD HH:MM:SS" -> "MM-DD-YYYY HH:MM"
  local m="$1"
  if [[ "$m" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})\ ([0-9]{2}:[0-9]{2}) ]]; then
    printf '%s-%s-%s %s' "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[1]}" "${BASH_REMATCH[4]}"
  else
    printf '%-10s %-5s' "" ""
  fi
}

plural() { (($1 == 1)) && printf '%s file' "$1" || printf '%s files' "$1"; }

ratio() { # percent saved, rounded like unzip
  local size="$1" packed="$2"
  if ((size == 0)); then
    echo 0
  elif ((packed > size)); then
    echo $((-((100 * (packed - size) + size / 2) / size)))
  else
    echo $(((100 * (size - packed) + size / 2) / size))
  fi
}

method_name() {
  case "$1" in
    *Store* | Copy) echo "Stored" ;;
    Deflate*) echo "Defl:N" ;;
    BZip2) echo "BZip2" ;;
    LZMA*) echo "LZMA" ;;
    "") echo "Unk:" ;;
    *) printf '%.6s' "$1" ;;
  esac
}

do_list() {
  local archive="$1" i total=0
  print_header "$archive"
  printf '  Length      Date    Time    Name\n'
  printf -- '---------  ---------- -----   ----\n'
  for i in "${SEL[@]}"; do
    printf '%9d  %s   %s\n' "${E_SIZE[i]}" "$(fmt_date "${E_MTIME[i]}")" "$(dname "$i")"
    total=$((total + E_SIZE[i]))
  done
  printf -- '---------                     -------\n'
  printf '%9d                     %s\n' "$total" "$(plural ${#SEL[@]})"
}

do_verbose() {
  local archive="$1" i total=0 ptotal=0 crc
  print_header "$archive"
  printf ' Length   Method    Size  Cmpr    Date    Time   CRC-32   Name\n'
  printf -- '--------  ------  ------- ---- ---------- ----- --------  ----\n'
  for i in "${SEL[@]}"; do
    crc="${E_CRC[i]:-00000000}"
    printf '%8d  %-6s %8d %3d%% %s %8s  %s\n' \
      "${E_SIZE[i]}" "$(method_name "${E_METHOD[i]}")" "${E_PACKED[i]}" \
      "$(ratio "${E_SIZE[i]}" "${E_PACKED[i]}")" "$(fmt_date "${E_MTIME[i]}")" \
      "${crc,,}" "$(dname "$i")"
    total=$((total + E_SIZE[i]))
    ptotal=$((ptotal + E_PACKED[i]))
  done
  printf -- '--------          -------  ---                            -------\n'
  printf '%8d          %7d %3d%%                            %s\n' \
    "$total" "$ptotal" "$(ratio "$total" "$ptotal")" "$(plural ${#SEL[@]})"
}

do_comment() {
  local archive="$1"
  printf 'Archive:  %s\n' "$archive"
  [[ -n "$ARCHIVE_COMMENT" ]] && printf '%s\n' "$ARCHIVE_COMMENT"
  return 0
}

# Write selected entries to a 7z listfile. Directory entries are only listed
# when empty: 7z would otherwise pull in their whole subtree.
write_listfile() {
  local list="$1" i p
  local -A has_child=()

  for p in "${E_PATH[@]}"; do
    while [[ "$p" == */* ]]; do
      p="${p%/*}"
      has_child["$p"]=1
    done
  done

  : >"$list"
  for i in "${SEL[@]}"; do
    if [[ "${E_DIR[i]}" == 1 ]]; then
      ((JUNK)) && continue
      [[ -n "${has_child["${E_PATH[i]}"]:-}" ]] && continue
    fi
    printf '%s\n' "${E_PATH[i]}" >>"$list"
  done
}

# Build 7z selection args: none when everything is selected.
selection_args() {
  SEL_ARGS=()
  if ((${#SEL[@]} != ${#E_PATH[@]} || JUNK)); then
    write_listfile "$TMP/select.lst"
    SEL_ARGS=(-scsUTF-8 "-ir-@$TMP/select.lst")
  fi
}

check_7z_errors() {
  local rc="$1" errfile="$2"
  if [[ -s "$errfile" ]]; then
    cat "$errfile" >&2
    if grep -q 'Wrong password' "$errfile"; then
      echo "$E_BADPWD"
      return
    fi
  fi
  map_rc "$rc"
}

do_test() {
  local archive="$1" rc line name i
  local -A idx_of=()

  print_header "$archive"
  ((${#SEL[@]} == 0)) && return "$E_OK"

  ensure_password "$archive"
  ((${#SEL[@]} == 0)) && return "$E_OK"

  for i in "${SEL[@]}"; do
    idx_of["${E_PATH[i]}"]="$i"
  done

  selection_args

  run_7z t -bb1 -bd -bsp0 -bse2 -sccUTF-8 "${SEL_ARGS[@]}" -- "$archive" 2>"$TMP/7z.err" |
    while IFS= read -r line; do
      [[ "$line" == "T "* ]] || continue
      name="${line#T }"
      i="${idx_of["$name"]:-}"
      [[ -n "$i" ]] && name="$(dname "$i")"
      ((QUIET)) || printf '    testing: %-24s OK\n' "$name"
    done

  check_7z_errors "${PIPESTATUS[0]}" "$TMP/7z.err" >"$TMP/rc"
  return "$(<"$TMP/rc")"
}

do_pipe() {
  local archive="$1" rc i

  [[ "$MODE" == "cat" ]] && print_header "$archive"
  ((${#SEL[@]} == 0)) && return "$E_OK"
  ensure_password "$archive"
  ((${#SEL[@]} == 0)) && return "$E_OK"

  if [[ "$MODE" == "pipe" ]]; then
    selection_args
    run_7z x -so -bsp0 -bse2 -sccUTF-8 "${SEL_ARGS[@]}" -- "$archive" 2>"$TMP/7z.err"
    rc=$(check_7z_errors "$?" "$TMP/7z.err")
    return "$rc"
  fi

  # -c: per-file with headers, like unzip
  for i in "${SEL[@]}"; do
    [[ "${E_DIR[i]}" == 1 ]] && continue
    ((QUIET)) || print_action "${E_METHOD[i]}" "${E_PATH[i]}"
    printf '%s\n' "${E_PATH[i]}" >"$TMP/one.lst"
    run_7z x -so -bsp0 -bse2 -sccUTF-8 -scsUTF-8 "-ir-@$TMP/one.lst" -- "$archive" 2>"$TMP/7z.err"
    rc=$(check_7z_errors "$?" "$TMP/7z.err")
    ((rc != 0)) && return "$rc"
    printf '\n'
  done
  return 0
}

PROMPT_EOF=0

# Ask unzip's overwrite question. Sets ANSWER to y|n|A|N|r.
ask_replace() {
  local dest="$1" reply
  while true; do
    printf 'replace %s? [y]es, [n]o, [A]ll, [N]one, [r]ename: ' "$dest"
    if ! IFS= read -r reply; then
      printf '\n(EOF or read error, treating as "[N]one" ...)\n'
      PROMPT_EOF=1
      ANSWER="N"
      return
    fi
    case "$reply" in
      y | Y | yes) ANSWER="y"; return ;;
      n | no) ANSWER="n"; return ;;
      A) ANSWER="A"; return ;;
      N) ANSWER="N"; return ;;
      r | R) ANSWER="r"; return ;;
      *) printf 'error:  invalid response [%s]\n' "${reply:0:1}" ;;
    esac
  done
}

dest_of() {
  local i="$1" rel="${E_PATH[$1]}"
  ((JUNK)) && rel="${rel##*/}"
  if [[ -n "$EXDIR" ]]; then
    printf '%s/%s' "${EXDIR%/}" "$rel"
  else
    printf '%s' "$rel"
  fi
}

do_extract() {
  local archive="$1" i dest policy="$OVERWRITE" arc_t disk_t newname rc line name idx
  local -a keep=() renames=()
  local -A idx_of=()

  print_header "$archive"

  # Decide per entry, mirroring unzip's -f/-u/-n/-o/prompt logic
  for i in "${SEL[@]}"; do
    if [[ "${E_DIR[i]}" == 1 ]]; then
      ((JUNK || FRESHEN)) || keep+=("$i")
      continue
    fi

    dest="$(dest_of "$i")"

    if [[ ! -e "$dest" && ! -L "$dest" ]]; then
      ((FRESHEN)) || keep+=("$i")
      continue
    fi

    if ((FRESHEN || UPDATE)); then
      arc_t=$(to_epoch "${E_MTIME[i]}")
      disk_t=$(file_mtime "$dest")
      if [[ -n "$arc_t" && -n "$disk_t" ]] && ((arc_t <= disk_t)); then
        continue
      fi
    fi

    case "$policy" in
      always) keep+=("$i") ;;
      never) ;;
      prompt)
        ask_replace "$dest"
        case "$ANSWER" in
          y) keep+=("$i") ;;
          A) policy="always"; keep+=("$i") ;;
          N) policy="never" ;;
          r)
            printf 'new name: '
            IFS= read -r newname || newname=""
            if [[ -n "$newname" ]]; then
              [[ -n "$EXDIR" && "$newname" != /* ]] && newname="${EXDIR%/}/$newname"
              renames+=("$i" "$newname")
            fi
            ;;
        esac
        ;;
    esac
  done

  if ((${#keep[@]} == 0 && ${#renames[@]} == 0)); then
    return 0
  fi

  SEL=("${keep[@]}")
  ensure_password "$archive"
  keep=("${SEL[@]}")

  rc=0
  if ((${#keep[@]} > 0)); then
    for i in "${keep[@]}"; do
      idx_of["${E_PATH[i]}"]="$i"
    done

    selection_args
    local -a cmd=("$( ((JUNK)) && echo e || echo x)" -bb1 -bd -bsp0 -bse2 -y -aoa -sccUTF-8)
    [[ -n "$EXDIR" ]] && cmd+=("-o$EXDIR")

    run_7z "${cmd[@]}" "${SEL_ARGS[@]}" -- "$archive" 2>"$TMP/7z.err" |
      while IFS= read -r line; do
        ((QUIET)) && continue
        [[ "$line" == "- "* ]] || continue
        name="${line#- }"
        idx="${idx_of["$name"]:-}"
        [[ -z "$idx" ]] && continue
        if [[ "${E_DIR[idx]}" == 1 ]]; then
          printf '   creating: %s/\n' "$(dest_of "$idx")"
        else
          print_action "${E_METHOD[idx]}" "$(dest_of "$idx")"
        fi
      done
    rc=$(check_7z_errors "${PIPESTATUS[0]}" "$TMP/7z.err")
  fi

  # Renamed entries are streamed individually to their new names
  for ((i = 0; i < ${#renames[@]}; i += 2)); do
    idx="${renames[i]}"
    newname="${renames[i + 1]}"
    mkdir -p -- "$(dirname -- "$newname")"
    printf '%s\n' "${E_PATH[idx]}" >"$TMP/one.lst"
    if run_7z x -so -bsp0 -bse2 -sccUTF-8 -scsUTF-8 "-ir-@$TMP/one.lst" -- "$archive" \
      >"$newname" 2>"$TMP/7z.err"; then
      ((QUIET)) || print_action "${E_METHOD[idx]}" "$newname"
    else
      rc=$(check_7z_errors 2 "$TMP/7z.err")
    fi
  done

  return "$rc"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

resolve_archives() {
  local arg="$1" f
  ARCHIVES=()

  for f in "$arg" "$arg.zip" "$arg.ZIP"; do
    if [[ -f "$f" ]]; then
      ARCHIVES=("$f")
      return 0
    fi
  done

  if [[ "$arg" == *[\*\?\[]* ]]; then
    while IFS= read -r f; do
      [[ -f "$f" ]] && ARCHIVES+=("$f")
    done < <(compgen -G "$arg" | sort)
    ((${#ARCHIVES[@]} > 0)) && return 0
  fi

  err "cannot find or open $arg, $arg.zip or $arg.ZIP."
  return 1
}

process_archive() {
  local archive="$1" rc sel_rc

  BADPWD=0
  BADPWD_KEPT=0
  PROMPT_EOF=0
  load_entries "$archive" || return $?

  select_entries
  sel_rc=$?

  case "$MODE" in
    list) do_list "$archive" ;;
    verbose) do_verbose "$archive" ;;
    comment) do_comment "$archive" ;;
    test) do_test "$archive" ;;
    pipe | cat) do_pipe "$archive" ;;
    extract) do_extract "$archive" ;;
  esac
  rc=$?

  ((rc == 0)) && rc="$sel_rc"
  ((rc == 0 && PROMPT_EOF)) && rc="$E_WARN"
  # unzip: some entries skipped for a bad password is a warning; all is 82
  if ((BADPWD && rc == 0)); then
    ((BADPWD_KEPT > 0)) && rc="$E_WARN" || rc="$E_BADPWD"
  fi

  if [[ "$MODE" != list && "$MODE" != verbose && "$MODE" != comment ]]; then
    local pat
    for pat in "${UNMATCHED[@]}"; do
      printf 'caution: filename not matched:  %s\n' "$pat"
    done
  fi

  if [[ "$MODE" == test ]]; then
    if ((rc == E_WARN && BADPWD && BADPWD_KEPT > 0)); then
      printf 'No errors detected in %s for the %s tested.\n' "$archive" "$(plural "$BADPWD_KEPT")"
      printf '%s skipped because of incorrect password.\n' "$(plural "$BADPWD")"
    elif ((rc == E_BADPWD && BADPWD_KEPT == 0)); then
      printf 'Caution:  zero files tested in %s.\n' "$archive"
      printf '%s skipped because of incorrect password.\n' "$(plural "$BADPWD")"
    elif ((rc == 0)); then
      printf 'No errors detected in compressed data of %s.\n' "$archive"
    else
      printf 'At least one error was detected in %s.\n' "$archive"
    fi
  fi

  return "$rc"
}

main() {
  if (($# == 0)); then
    usage
    exit "$E_OK"
  fi

  parse_args "$@"

  find_7z || exit "$E_ERR"

  if [[ -z "$ARCHIVE_ARG" ]]; then
    if [[ "$MODE" == "verbose" ]]; then
      "$SZ" </dev/null 2>&1 | sed -n '/./{p;q;}'
      exit "$E_OK"
    fi
    usage >&2
    exit "$E_PARAM"
  fi

  TMP="$(mktemp -d "${TMPDIR:-/tmp}/unzip7z.XXXXXX")" || exit "$E_ERR"
  trap 'rm -rf -- "$TMP"' EXIT
  trap 'exit 80' INT TERM

  resolve_archives "$ARCHIVE_ARG" || exit "$E_NOZIP"

  local archive rc final=0 ok=0 bad=0 first=1
  for archive in "${ARCHIVES[@]}"; do
    if ((${#ARCHIVES[@]} > 1 && !first)); then
      [[ "$MODE" == "pipe" ]] || printf '\n'
    fi
    first=0

    process_archive "$archive"
    rc=$?
    if ((rc == 0 || rc == E_WARN || rc == E_FIND)); then
      ok=$((ok + 1))
    else
      bad=$((bad + 1))
    fi
    ((rc > final)) && final="$rc"
  done

  if ((${#ARCHIVES[@]} > 1)) && [[ "$MODE" != "pipe" ]]; then
    printf '\n%d archive%s successfully processed.\n' "$ok" "$( ((ok == 1)) && echo ' was' || echo 's were')"
    ((bad > 0)) && printf '%d archive%s had fatal errors.\n' "$bad" "$( ((bad == 1)) || echo s)"
  fi

  exit "$final"
}

main "$@"
